Sink(table=[default_catalog.default_database.MyMTNoConflictDefaultTable], fields=[a, cnt], upsertMaterialize=[true])
+- Calc(select=[a, cnt])
   +- GroupAggregate(groupBy=[a, c], select=[a, c, COUNT(*) AS cnt])
      +- Exchange(distribution=[hash[a, c]])
         +- TableSourceScan(table=[[default_catalog, default_database, MyTable, project=[a, c], metadata=[]]], fields=[a, c])

