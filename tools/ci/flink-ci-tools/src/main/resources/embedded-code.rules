# Third-party code that bundled dependencies embed in their own classes and native libraries:
# Netty and Conscrypt, the RocksDB, ForSt, snappy-java, lz4-java and zstd-jni natives, and
# scala-compiler. Their jars carry none of these licenses, so every jar that contains the code has
# to ship them. A native library that no section names fails the check, so a new one is looked
# into before it ships.
#
# Each [section] is one embedded component:
#   marker  = regex for a jar entry that contains the code (any match counts; repeatable)
#   license = file in META-INF/licenses/ that must be present (any one of them; repeatable)
#   license-text = text that the license file must contain
#   marker-content = regex the marker entry's contents must contain for the section to apply
#   notice  = text that META-INF/NOTICE must contain (all of them; repeatable)
#   native  = regex for a native library that is its project's own code and owes nothing extra
# A license file listed here that no marker in the jar justifies is reported as well.
#
# The markers come from the file headers of Netty's main sources, from the commits that added
# each entry to Netty's NOTICE.txt, and from the shade configuration of netty-common (JCTools),
# for every netty-4.1.*.Final and netty-4.2.*.Final tag up to the versions below. A jar that
# bundles a newer Netty fails until the sources of that version are checked again:
#   git grep -n -i -E 'copyright|public domain|written by|derived from' <tag> -- '*/src/main/*' \
#     | grep -v 'The Netty Project'
# and NOTICE.txt of that tag is compared with the sections below.
verified-netty = 4.1.141.Final
verified-netty = 4.2.21.Final

[netty]
marker = (.*/)?io/netty/.+\.class
notice = Copyright 2014 The Netty Project

[jsr166y]
marker = (.*/)?io/netty/util/internal/ThreadLocalRandom(\$.*)?\.class
marker = (.*/)?io/netty/util/concurrent/ConcurrentSkipListIntObjMultimap(\$.*)?\.class
marker = (.*/)?io/netty/util/internal/chmv8/.+\.class
license = LICENSE.jsr166y.txt
license-text = public domain

[base64]
marker = (.*/)?io/netty/handler/codec/base64/Base64(Dialect)?(\$.*)?\.class
license = LICENSE.base64.txt
license-text = public domain

[webbit]
marker = (.*/)?io/netty/handler/codec/http/websocketx/WebSocket(07|08|13)Frame(De|En)coder(\$.*)?\.class
license = LICENSE.webbit.txt
license-text = Joe Walnes

# Not in Netty's NOTICE.txt; the license is in the header of Utf8Validator.java.
[hoehrmann-utf8]
marker = (.*/)?io/netty/handler/codec/http/websocketx/Utf8Validator(\$.*)?\.class
license = LICENSE.hoehrmann-utf8.txt
license-text = Bjoern Hoehrmann

[slf4j]
marker = (.*/)?io/netty/util/internal/logging/(CommonsLogger|FormattingTuple|InternalLogger|JdkLogger|Log4JLogger|MessageFormatter)(\$.*)?\.class
license = LICENSE.slf4j.txt
license-text = QOS.ch

[harmony]
marker = (.*/)?io/netty/util/NetUtil(\$.*)?\.class
notice = Apache Harmony

[jbzip2]
marker = (.*/)?io/netty/handler/codec/compression/Bzip2Decoder(\$.*)?\.class
license = LICENSE.jbzip2.txt
license-text = Matthew J. Francis

[libdivsufsort]
marker = (.*/)?io/netty/handler/codec/compression/Bzip2DivSufSort(\$.*)?\.class
license = LICENSE.libdivsufsort.txt
license-text = Yuta Mori

[jctools]
marker = (.*/)?io/netty/util/internal/shaded/org/jctools/.+\.class
marker = (.*/)?io/netty/util/concurrent/MpscAtomicIntegerArrayQueue(\$.*)?\.class
notice = JCTools

[jfastlz]
marker = (.*/)?io/netty/handler/codec/compression/FastLz(\$.*)?\.class
license = LICENSE.jfastlz.txt
license-text = William Kinney

[protobuf]
marker = (.*/)?io/netty/handler/codec/protobuf/ProtobufVarint32(FrameDecoder|LengthFieldPrepender)(\$.*)?\.class
license = LICENSE.protobuf.txt
license-text = Google Inc.

[twitter-hpack]
marker = (.*/)?io/netty/handler/codec/http2/Hpack(Decoder|Encoder|DynamicTable|HeaderField|HuffmanDecoder|HuffmanEncoder|StaticTable|Util)(\$.*)?\.class
marker = (.*/)?io/netty/handler/codec/http2/internal/hpack/.+\.class
notice = twitter/hpack

# Added to Netty's NOTICE.txt in 4.1.38 together with the table-driven HpackHuffmanDecoder. The
# class itself exists since 4.1.9, so a Netty from 4.1.9 to 4.1.37 is asked for both licenses
# needlessly; Flink bundles none that old.
[hyper-hpack]
marker = (.*/)?io/netty/handler/codec/http2/HpackHuffmanDecoder(\$.*)?\.class
license = LICENSE.hyper-hpack.txt
license-text = Cory Benfield

[nghttp2-hpack]
marker = (.*/)?io/netty/handler/codec/http2/HpackHuffmanDecoder(\$.*)?\.class
license = LICENSE.nghttp2-hpack.txt
license-text = Tatsuhiro Tsujikawa

# Netty added this to NOTICE.txt in 2015 with the regionMatches helpers of AsciiString
# (netty/netty@2a65ae256e); every netty-common since then contains them. The text is Netty's
# own: many jars also carry Apache Commons Lang's NOTICE, which starts with the project name.
[commons-lang]
marker = (.*/)?io/netty/util/AsciiString(\$.*)?\.class
notice = a modified portion of 'Apache Commons Lang'

[dnsinfo]
marker = META-INF/native/[^/]*netty_resolver_dns_native_macos[^/]*
license = LICENSE.dnsinfo.txt
license-text = Apple

# netty-tcnative, classes and natives, is a fork of Tomcat Native with a NOTICE of its own.
[tcnative]
marker = (.*/)?io/netty/internal/tcnative/.+\.class
marker = META-INF/native/[^/]*netty_tcnative[^/]*
notice = Copyright 2016 The Netty Project
notice = Tomcat Native

# The tcnative natives link BoringSSL statically. BoringSSL is under the OpenSSL license before
# February 2025 and under the Apache License 2.0 since then; the jar doesn't tell which applies.
[tcnative-boringssl]
marker = META-INF/native/[^/]*netty_tcnative[^/]*
license = LICENSE.boringssl.txt
license = LICENSE.boringssl-openssl.txt

# Conscrypt 2.5.2, the version gcs-connector uses, links a BoringSSL from before February 2025.
[conscrypt]
marker = META-INF/native/[^/]*conscrypt_openjdk_jni[^/]*
license = LICENSE.boringssl-openssl.txt
license-text = OpenSSL

# Conscrypt's NOTICE isn't part of its jar.
[conscrypt-notice]
marker = (.*/)?org/conscrypt/Conscrypt(\$.*)?\.class
notice = Copyright 2016 The Android Open Source Project

[quiche]
marker = META-INF/native/[^/]*netty_quiche[^/]*
license = LICENSE.quiche.txt
license-text = Cloudflare

[quiche-boringssl]
marker = META-INF/native/[^/]*netty_quiche[^/]*
license = LICENSE.boringssl.txt

# The OpenSSL and SSLeay licenses ask binary redistributions to acknowledge the OpenSSL Project,
# Eric Young and Tim Hudson in their documentation, as Tomcat Native's NOTICE does.
[openssl-acknowledgment]
marker = META-INF/licenses/LICENSE\.boringssl-openssl\.txt
notice = OpenSSL Project
notice = Eric Young
notice = Tim Hudson

[netty-natives]
native = META-INF/native/[^/]*netty_transport_native_(epoll|kqueue)[^/]*
native = META-INF/native/[^/]*netty_transport_native_io_uring[^/]*

# The natives of frocksdbjni and forstjni, and those of snappy-java, lz4-java and zstd-jni, link
# third-party libraries statically. The lists come from the Makefile of frocksdb 6.20.3 and 8.10.0
# and ForSt 0.1.8 (ZLIB_VER, BZIP2_VER, SNAPPY_VER, LZ4_VER, ZSTD_VER and rocksdbjavastatic),
# RocksDB's own util/ (xxhash.h, murmurhash.cc) and LICENSE.leveldb, snappy-java's Makefile
# (BITSHUFFLE_C) and the symbols each library defines. zlib, bzip2 and MurmurHash ask for no
# notice in binaries, but ASF policy wants every bundled license accounted for.
[leveldb]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
license = LICENSE.leveldb.txt
license-text = The LevelDB Authors

[snappy]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
marker = (.*/)?org/xerial/snappy/native/.+
license = LICENSE.google-snappy.txt
license-text = Google Inc.

[lz4]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
marker = (.*/)?net/jpountz/util/[^/]+/[^/]+/(lib)?lz4-java\.[^/]+
license = LICENSE.liblz4.txt
license-text = LZ4 Library

[xxhash]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
marker = (.*/)?net/jpountz/util/[^/]+/[^/]+/(lib)?lz4-java\.[^/]+
license = LICENSE.xxhash.txt
license-text = Yann Collet

# zstd-jni's natives carry Zstandard's own copy of xxHash, under Zstandard's license.
[zstd]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
marker = (linux|darwin|win|freebsd|aix)/[^/]+/(lib)?zstd-jni-[^/]+
license = LICENSE.zstd.txt
license-text = Zstandard

[zlib]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
license = LICENSE.zlib.txt
license-text = Jean-loup Gailly

[bzip2]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
license = LICENSE.bzip2.txt
license-text = Julian R Seward

[murmurhash]
marker = (.*/)?lib(rocksdbjni|forstjni)-[^/]+
license = LICENSE.murmurhash.txt
license-text = public domain

[bitshuffle]
marker = (.*/)?org/xerial/snappy/native/.+
license = LICENSE.bitshuffle.txt
license-text = Kiyoshi Masui

# snappy-java's NOTICE is in its repository, not in its jar.
[snappy-java]
marker = (.*/)?org/xerial/snappy/native/.+
notice = PureJavaCrc32C

# Scala is under the Apache License 2.0 with a NOTICE since 2.12.8.
[scala]
marker = (.*/)?library\.properties
marker-content = version\.number=(2\.12\.([89]|[1-9][0-9])|2\.1[3-9]\.|3\.)
notice = Scala includes software developed at

# scala-compiler's own doc/LICENSE.md lists ASM, JLine, Jansi (Apache License 2.0) and the
# scaladoc web assets, but neither HawtJNI nor scaladoc's fonts.
[scala-asm]
marker = (.*/)?scala/tools/asm/.+\.class
license = LICENSE.scala-asm.txt
license-text = INRIA, France Telecom

[scala-jline]
marker = (.*/)?scala/tools/jline_embedded/.+\.class
license = LICENSE.scala-jline.txt
license-text = Copyright (c) 2002-2016, the original author or authors

# HawtJNI's runtime classes and the hawtjni.c that the Jansi native libraries are built with are
# under the Eclipse Public License 1.0.
[scala-hawtjni]
marker = (.*/)?scala/tools/fusesource_embedded/hawtjni/.+\.class
marker = META-INF/native/[^/]+/(lib)?jansi\.(so|jnilib|dll)
license = LICENSE.scala-hawtjni.txt
license-text = Eclipse Public License - v 1.0
notice = developed by FuseSource Corp.

# Flink's shade configuration leaves scaladoc's jQuery, its plugins, Modernizr and its fonts under
# the SIL Open Font License out; a jar that ships them needs their licenses.
[scaladoc-assets]
marker = jquery[^/]*\.js
marker = (.*/)?scala/tools/nsc/doc/html/resource/lib/(jquery|modernizr)[^/]*\.js
marker = (.*/)?scala/tools/nsc/doc/html/resource/lib/tools\.tooltip\.js
marker = (.*/)?scala/tools/nsc/doc/html/resource/lib/(lato|source-code-pro)-[^/]+
license = LICENSE.scaladoc-assets.txt

# Natives that are their project's own code: async-profiler, jline-native (LICENSE.jline) and
# wildfly-openssl, which loads the system's OpenSSL at runtime.
[own-natives]
native = (.*/)?(linux-(x64|arm64)|macos)/libasyncProfiler\.so
native = (.*/)?org/jline/nativ/.+/(lib)?jlinenative\.(so|jnilib|dll)
native = (.*/)?(linux|macosx|solaris|win)-[^/]+/(lib)?wfssl\.(so|dylib|dll)
