<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.apache.flink</groupId>
		<artifactId>flink-models</artifactId>
		<version>2.4-SNAPSHOT</version>
	</parent>

	<artifactId>flink-model-openai</artifactId>
	<name>Flink : Models : OpenAI</name>

	<properties>
		<openai.version>4.63.1</openai.version>
		<openai.kotlin.version>1.9.10</openai.kotlin.version>
		<okhttp.version>4.12.0</okhttp.version>
		<test.gson.version>2.11.0</test.gson.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib</artifactId>
				<version>${openai.kotlin.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-jdk8</artifactId>
				<version>${openai.kotlin.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-jdk7</artifactId>
				<version>${openai.kotlin.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-reflect</artifactId>
				<version>${openai.kotlin.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>com.openai</groupId>
			<artifactId>openai-java</artifactId>
			<version>${openai.version}</version>
			<optional>${flink.markBundledAsOptional}</optional>
		</dependency>

		<dependency>
			<groupId>com.knuddels</groupId>
			<artifactId>jtokkit</artifactId>
			<version>1.1.0</version>
			<optional>${flink.markBundledAsOptional}</optional>
		</dependency>

		<!-- Core dependencies -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-core</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-api-java</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-common</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- test dependencies -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-planner_${scala.binary.version}</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>mockwebserver</artifactId>
			<version>${okhttp.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-api-java-bridge</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-clients</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-test-utils-junit</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<repositories>
		<!-- openai-java is not yet available in redhat or google mirrors -->
		<repository>
			<id>forced-central</id>
			<url>https://repo1.maven.org/maven2</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<id>shade-flink</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>*:*</include>
								</includes>
								<excludes>
									<exclude>com.google.code.findbugs:jsr305</exclude>
								</excludes>
							</artifactSet>
							<relocations combine.children="append">
								<!--
								Patterns are Java packages, not Maven groupIds, and carry a trailing dot: the shade
								plugin matches them as a bare prefix against string constants too, so "kotlin"
								would also rewrite "kotlinx" and ".kotlin_builtins".
								-->
								<!--
								com.openai and kotlin deliberately stay unrelocated. openai-java is written in Kotlin
								and reflects over its own classes through jackson-module-kotlin. Relocating com.openai
								makes kotlin-reflect fail with "Could not compute caller for function: private
								constructor Body(...)"; relocating kotlin moves kotlin/*.kotlin_builtins away from the
								path kotlin-reflect builds from the bare literal "kotlin", giving "Built-in class
								kotlin.Any is not found". Measured against the shaded jar: the module's own tests go
								22/22 to 10/22 with com.openai relocated, and a jar-only reflection probe fails
								outright with kotlin relocated.
								-->
								<relocation>
									<pattern>com.fasterxml.jackson.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.com.fasterxml.jackson.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.classmate.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.com.fasterxml.classmate.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.knuddels.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.com.knuddels.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.github.victools.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.com.github.victools.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.google.errorprone.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.com.google.errorprone.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>io.swagger.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.io.swagger.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>okhttp3.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.okhttp3.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>okio.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.okio.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.jetbrains.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.org.jetbrains.</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.intellij.</pattern>
									<shadedPattern>org.apache.flink.model.openai.shaded.org.intellij.</shadedPattern>
								</relocation>
								<!--
								Manually relocate multi-release classes to the correct shaded package. This is needed
								due to a bug in the Maven Shade plugin, which only relocates the content but not
								the package structure itself, see https://github.com/apache/maven-shade-plugin/issues/652.
								Only listed for the dependencies that actually ship META-INF/versions entries; the
								check_shaded_artifacts_model CI check fails if a bump adds another one.
								-->
								<relocation>
									<pattern>META-INF/versions/(\d+)/com/fasterxml/jackson/</pattern>
									<shadedPattern>META-INF/versions/$1/org/apache/flink/model/openai/shaded/com/fasterxml/jackson/</shadedPattern>
									<rawString>true</rawString>
								</relocation>
							</relocations>
							<filters combine.children="append">
								<filter>
									<artifact>*</artifact>
									<excludes>
										<exclude>okhttp3/internal/publicsuffix/NOTICE</exclude>
										<!-- Drop stale JPMS descriptors; with Multi-Release set below, the jar would otherwise claim a dependency's module name (FLINK-40145). -->
										<exclude>META-INF/**/module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers combine.children="append">
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<manifestEntries>
										<Multi-Release>true</Multi-Release>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
